{
  "name": "draw-empty",
  "private": true,
  "version": "0.1.0",
  "description": "DrawE（draw-empty）：基于 Vue 3 与 unDraw 的插画空状态组件与文档示例",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "prepare:undraw": "node scripts/setup-undraw-demos.cjs",
    "prepare:undraw:all": "node scripts/setup-undraw-demos.cjs --all",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "pack": "npm pack --pack-destination releases"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.7"
  }
}
